{
  "name": "imob360",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema completo de gestao imobiliaria",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @imob360/database generate",
    "db:push": "pnpm --filter @imob360/database push",
    "db:migrate": "pnpm --filter @imob360/database migrate",
    "db:seed": "pnpm --filter @imob360/database seed",
    "db:studio": "pnpm --filter @imob360/database studio",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
