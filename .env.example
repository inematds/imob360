# Database
POSTGRES_USER=imob360
POSTGRES_PASSWORD=imob360_secure_password
POSTGRES_DB=imob360
DATABASE_URL=postgresql://imob360:imob360_secure_password@localhost:5432/imob360

# Redis
REDIS_URL=redis://localhost:6379

# API
NODE_ENV=development
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key

# WhatsApp Integration (Evolution API)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_SERVER_URL=http://localhost:8080

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Digital Signature (Clicksign)
CLICKSIGN_API_KEY=your-clicksign-api-key
CLICKSIGN_ENVIRONMENT=sandbox

# Payment Gateway (Asaas)
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENVIRONMENT=sandbox

# Email (SendGrid / SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@imob360.com.br

# Storage (AWS S3 / Google Cloud Storage)
STORAGE_TYPE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
# GCS_PROJECT_ID=
# GCS_BUCKET=

# Portals Integration
ZAP_CLIENT_ID=
ZAP_CLIENT_SECRET=
VIVAREAL_CLIENT_ID=
VIVAREAL_CLIENT_SECRET=
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=

# AI Features (OpenAI)
OPENAI_API_KEY=your-openai-api-key

# Monitoring
SENTRY_DSN=
